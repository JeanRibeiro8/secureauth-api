# PostgreSQL connection (replace credentials with your local database values)
DATABASE_URL=postgresql+psycopg://secureauth_user:replace_me@localhost:5432/secureauth_db

# Generate a strong random value; do not reuse this example in production.
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME=SecureAuth API
ENVIRONMENT=development
